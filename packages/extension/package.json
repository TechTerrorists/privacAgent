{
  "name": "@privacagent/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome and Firefox MV3 extension: perception, privacy and execution client",
  "scripts": {
    "dev:chrome": "vite --mode chrome",
    "dev:firefox": "vite --mode firefox",
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "vite build --mode chrome && vite build --mode chrome --config vite.content.config.ts",
    "build:firefox": "vite build --mode firefox && vite build --mode firefox --config vite.content.config.ts",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir web-ext-artifacts --overwrite-dest",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted"
  },
  "dependencies": {
    "@privacagent/protocol": "workspace:*",
    "@privacagent/ui-kit": "workspace:*",
    "preact": "^10.29.8",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.28",
    "@types/webextension-polyfill": "^0.12.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "web-ext": "^10.7.0"
  }
}
