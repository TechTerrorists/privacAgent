{
  "name": "privacagent",
  "version": "0.0.0",
  "private": true,
  "description": "On-device visual perception and privacy gateway for browser agents",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:chrome": "pnpm --filter @privacagent/extension build:chrome",
    "build:firefox": "pnpm --filter @privacagent/extension build:firefox",
    "dev:chrome": "pnpm --filter @privacagent/extension dev:chrome",
    "dev:firefox": "pnpm --filter @privacagent/extension dev:firefox",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --force && tsc -p tsconfig.node.json && tsc -p packages/extension/tests/tsconfig.json && tsc -p bench/mock-sites/tsconfig.json",
    "test": "vitest run && uv run --locked pytest",
    "protocol:generate": "pnpm --filter @privacagent/protocol generate",
    "protocol:check": "pnpm --filter @privacagent/protocol generate:check",
    "test:watch": "vitest",
    "test:browser": "pnpm build && playwright test",
    "bench:dom": "playwright test --grep benchmark",
    "mocks:start": "node bench/mock-sites/server.mjs",
    "test:mocks": "playwright test bench/mock-sites/tests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
